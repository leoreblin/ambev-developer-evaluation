{
  "info": {
    "name": "Ambev Developer Evaluation API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "branchId",
      "value": ""
    },
    {
      "key": "saleId",
      "value": ""
    },
    {
      "key": "saleItemId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@local.com\",\n  \"password\": \"default@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json && json.data && json.data.token) {",
                  "    pm.collectionVariables.set(\"token\", json.data.token);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sales",
      "item": [
        {
          "name": "Create Sale",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"branchId\": \"{{branchId}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 4,\n      \"unitPrice\": 10.0\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sales"
              ]
            }
          }
        },
        {
          "name": "Create Sale From Cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"branchId\": \"{{branchId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sales/from-cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sales",
                "from-cart"
              ]
            }
          }
        },
        {
          "name": "Get Sale By Id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales/{{saleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sales",
                "{{saleId}}"
              ]
            }
          }
        },
        {
          "name": "Update Sale",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 5,\n      \"unitPrice\": 10.0\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sales/{{saleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sales",
                "{{saleId}}"
              ]
            }
          }
        },
        {
          "name": "Cancel Sale",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales/{{saleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sales",
                "{{saleId}}"
              ]
            }
          }
        },
        {
          "name": "Cancel Sale Item",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales/{{saleId}}/items/{{saleItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sales",
                "{{saleId}}",
                "items",
                "{{saleItemId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
