            "url": {
              "raw": "{{baseUrl}}/products?pageNumber=1&pageSize=10&orderBy=Title&isDescending=false&term=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
